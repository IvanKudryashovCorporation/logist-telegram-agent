# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Телефон аккаунта, от лица которого агент читает рабочие группы
TG_PHONE=
# Имя файла сессии Telethon (создаётся скриптом scripts/auth_telegram.py)
TG_SESSION_NAME=logist

# --- Чаты ---
# Рабочих групп диспетчеров может быть несколько — список ведётся в БД через
# scripts.manage_work_groups, а не здесь. WORK_GROUP_CHAT_ID оставлен только
# для разового переноса уже настроенной группы при первом запуске новой версии.
WORK_GROUP_CHAT_ID=

# --- LLM ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Задайте, только если ключ выдан прокси-сервисом, а не напрямую console.anthropic.com
LLM_BASE_URL=
# Таймаут одного запроса к LLM, секунд.
LLM_TIMEOUT_SECONDS=30
# Сколько раз повторяем запрос при таймауте/429/5xx, прежде чем отложить
# сообщение в очередь повторного разбора.
LLM_MAX_RETRIES=3
# База экспоненциальной задержки между повторами, секунд.
LLM_RETRY_BACKOFF_SECONDS=1

# --- База данных ---
# Локально: SQLite. Прод: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./logist.db

# --- Веб-панель ---
# Локально не трогать (127.0.0.1 — недоступно снаружи). На VPS для внешнего
# доступа поставить 0.0.0.0 и открыть порт в файрволе (см. README).
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Заказов на одной странице ленты. Пагинация обязательна: без неё лента
# отдаёт всю таблицу разом и тормозит по мере роста базы.
WEB_PAGE_SIZE=60
# Сколько секунд держать в памяти справочник городов для автодополнения.
CITY_CACHE_TTL_SECONDS=120
# Показывать телефон/имя клиента только водителю, взявшему заказ.
# Сайт публичный и без логина: открытые телефоны собирают парсерами за минуты.
# Диспетчер (кому писать) остаётся видимым всем — иначе кнопка теряет смысл.
MASK_CLIENT_CONTACTS=true
# Сайт работает за nginx/Caddy — реальный IP клиента лежит в X-Forwarded-For.
# Поставить false, если сайт доступен напрямую без доверенного прокси:
# иначе любой посетитель подменит заголовок и обойдёт ограничение частоты.
TRUST_PROXY_HEADERS=true

# --- Ограничение частоты запросов (анти-скрейпинг и анти-флуд) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GET_PER_MINUTE=120
RATE_LIMIT_POST_PER_MINUTE=30

# --- Контакт владельца ---
# Telegram username (без @) для кнопки «Обратная связь» вверху ленты.
OWNER_CONTACT_USERNAME=lmaosrk

# --- Админка (/admin) ---
# Telegram id владельцев через запятую (свой id: написать боту /start и открыть
# https://api.telegram.org/bot<токен>/getUpdates). Админка открывается ТОЛЬКО
# вошедшему через Telegram владельцу, остальным её нет (404). Пароля нет.
ADMIN_TELEGRAM_IDS=
# Секрет подписи cookie админки. Если не задан, выводится из пароля, поэтому
# смена пароля автоматически «разлогинивает» все сессии.
#
# ВАЖНО: обязателен (не пуст), если используете вход через Telegram ниже —
# им же подписывается сессия водителя, а слабый секрет по умолчанию
# ("admin::" при выключенной админке) для реальных аккаунтов недопустим.
SESSION_SECRET=

# --- Вход через Telegram (Login Widget) ---
# Токен ОБЫЧНОГО бота из @BotFather (НЕ userbot-аккаунт, который читает
# рабочие группы!). У бота через /setdomain должен быть привязан домен
# сайта — виджет работает только по HTTPS и только с этим доменом.
# Пусто — вход выключен целиком: лента видна всем как раньше, "Мои заказы"
# и карточка заказа доступны без входа (прежнее поведение).
TELEGRAM_LOGIN_BOT_TOKEN=
# Username бота без @.
TELEGRAM_LOGIN_BOT_USERNAME=
# Вход через бота: сайт сам принимает сообщения бота (getUpdates). false — если бота
# уже читает другая программа или на него настроен вебхук.
BOT_LOGIN_POLLING=true

# --- Геокодирование (радиус в фильтрах «откуда/куда») ---
# Фоновый воркер агента ставит заказам координаты через Nominatim
# (OpenStreetMap, лимит ~1 запрос/сек, результаты кэшируются в БД).
GEOCODING_ENABLED=true
# Nominatim требует User-Agent с вашим контактом — анонимных клиентов банит.
GEOCODER_USER_AGENT=podacha-geocoder/1.0 (you@example.com)
GEOCODE_POLL_SECONDS=30
GEOCODE_BATCH=20

# --- Разбор заявок ---
# Не отправлять в LLM сообщения, которые заведомо не являются заявкой
# («ок», «принял», короткие реплики без маршрута и цены). Экономит деньги
# и снимает риск упереться в rate-limit провайдера.
PREFILTER_ENABLED=true
# Кэш результатов разбора по хэшу текста (диспетчеры копируют заявки).
PARSE_CACHE_SIZE=1024
# Писать в parse_stats метрики каждого разбора (доля неполных заявок,
# расход токенов, латентность). Без них админка показывает нули.
PARSE_STATS_ENABLED=true

# --- Очередь повторного разбора ---
# Telethon НЕ переигрывает доставленное событие: если LLM ответила 429 или
# таймаутом, без очереди сообщение терялось навсегда.
QUEUE_ENABLED=true
QUEUE_MAX_ATTEMPTS=6
# Задержка первой попытки, секунд; дальше растёт экспоненциально (потолок 6 ч).
QUEUE_BASE_DELAY_SECONDS=60
# Как часто воркер просматривает очередь, секунд.
QUEUE_POLL_SECONDS=60

# --- Фоновое обслуживание данных ---
# Через сколько часов после времени подачи заявка становится EXPIRED.
EXPIRE_GRACE_HOURS=6
# Периодичность фоновой очистки, минут.
EXPIRE_POLL_MINUTES=15
# Через сколько часов после публикации закрывается заявка «в ближайшее время».
ASAP_EXPIRE_HOURS=48
# Заказ «Договорился» без точного времени становится «В работе» через столько часов.
ASAP_WORK_START_HOURS=3
# Через сколько часов после дедлайна заказ сам становится «Выполнен».
AUTO_COMPLETE_HOURS=72
# Через сколько дней удалять насовсем просроченные/снятые заказы, которые никто не брал
# (0 — не удалять). Заказы водителей не удаляются никогда.
CLOSED_ORDERS_RETENTION_DAYS=30
# Сколько дней хранить строки parse_stats (0 — не удалять).
STATS_RETENTION_DAYS=30

# --- Уведомления водителям о новых заказах по фильтру ---
# Работают через бота входа (TELEGRAM_LOGIN_BOT_TOKEN) и пишут тем, кто включил
# галочку «присылать в Telegram» при применении фильтра.
PUBLIC_BASE_URL=https://lentazakazov.ru
SUBSCRIPTION_POLL_SECONDS=30
SUBSCRIPTION_MAX_LINES=8

# --- Сторож (scripts/watchdog.py, cron раз в 5 минут) ---
# Куда писать алерты: ваш id в Telegram (бот пишет только тому, кто нажал в нём
# «Старт» или входил через виджет). Узнать id: написать боту /start и открыть
# https://api.telegram.org/bot<токен>/getUpdates. Пусто — сторож молчит.
ALERT_CHAT_ID=
# Токен бота для алертов; пусто — берётся TELEGRAM_LOGIN_BOT_TOKEN.
ALERT_BOT_TOKEN=
WATCHDOG_AGENT_SILENCE_HOURS=3
WATCHDOG_LLM_ERRORS_PER_HOUR=10
WATCHDOG_DISK_PERCENT=85
WATCHDOG_REMINDER_HOURS=6

# --- Уведомления владельцу в Telegram ---
# Куда слать алерты: @username, числовой id чата или «me» (Избранное).
# Пусто — уведомления выключены, всё уходит только в лог.
NOTIFY_CHAT_ID=
NOTIFY_ON_START=true
# Сколько подряд ошибок разбора до алерта.
NOTIFY_ERROR_THRESHOLD=5
