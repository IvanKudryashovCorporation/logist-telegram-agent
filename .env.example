# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Телефон аккаунта, от лица которого агент читает рабочие группы
TG_PHONE=
# Имя файла сессии Telethon (создаётся скриптом scripts/auth_telegram.py)
TG_SESSION_NAME=logist

# --- Чаты ---
# Рабочих групп диспетчеров может быть несколько — список ведётся в БД через
# scripts.manage_work_groups, а не здесь. WORK_GROUP_CHAT_ID оставлен только
# для разового переноса уже настроенной группы при первом запуске новой версии.
WORK_GROUP_CHAT_ID=

# --- LLM ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Задайте, только если ключ выдан прокси-сервисом, а не напрямую console.anthropic.com
LLM_BASE_URL=

# --- База данных ---
# Локально: SQLite. Прод: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./logist.db

# --- Веб-панель ---
# Локально не трогать (127.0.0.1 — недоступно снаружи). На VPS для внешнего
# доступа поставить 0.0.0.0 и открыть порт в файрволе (см. README).
WEB_HOST=127.0.0.1
WEB_PORT=8000
