# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Телефон аккаунта логиста в международном формате, напр. +79991234567
TG_PHONE=
# Имя файла сессии Telethon (создаётся скриптом scripts/auth_telegram.py)
TG_SESSION_NAME=logist

# --- Чаты ---
# id рабочей закрытой группы диспетчеров (откуда агент читает заявки)
WORK_GROUP_CHAT_ID=
# id аккаунта логиста — куда агент шлёт уведомления и запросы подтверждения
LOGIST_USER_ID=

# --- LLM ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Задайте, только если ключ выдан прокси-сервисом, а не напрямую console.anthropic.com
LLM_BASE_URL=

# --- База данных ---
# Локально: SQLite. Прод: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./logist.db

# --- Бизнес-правила (из опроса) ---
# Доля от общей стоимости, предлагаемая водителю по умолчанию
DEFAULT_DRIVER_SHARE=0.80
# Стоимость часа ожидания, руб.
WAITING_RATE_PER_HOUR=500
# Максимальная надбавка при торге с водителем, %
MAX_NEGOTIATION_UPLIFT_PCT=15
# Надбавка при перепубликации срочного заказа без откликов, %
REPOST_UPLIFT_PCT=10
# Интервал перепубликации срочного заказа, минут
REPOST_INTERVAL_MINUTES=10
# Через сколько часов после подачи напоминать водителю про комиссию
COMMISSION_REMINDER_HOURS=24
# Реквизиты для оплаты комиссии (одни и те же для всех)
PAYMENT_DETAILS=
